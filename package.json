{
  "name": "express-demo-pemweb",
  "version": "1.0.0",
  "description": "API produk Pemrograman Web minggu 10 (Express + TypeScript + PostgreSQL + Prisma)",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
